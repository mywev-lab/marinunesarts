# Copie para .env e preencha para rodar o site no computador (npm run dev)
# Banco de dados (Supabase → Connect → Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Texto longo e aleatório (o mesmo da Vercel)
PAYLOAD_SECRET=
# Endereço do site
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Imagens no Supabase Storage (opcional no computador: sem isso, as imagens ficam na pasta /media)
S3_ENDPOINT=
S3_REGION=sa-east-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
