# Copie para .env e preencha para rodar o site no computador (npm run dev).
# No ar, a Vercel usa as variáveis da integração Supabase (POSTGRES_URL, SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET); as daqui têm preferência quando existem.

# Banco de dados: um Postgres local ou o do Supabase (Connect → Transaction pooler).
# Atenção: com o banco do Supabase, as alterações feitas no computador vão direto para o site no ar.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/payload

# Texto longo e aleatório que protege o login do painel
PAYLOAD_SECRET=

# Endereço do site no computador
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Opcional: imagens no Supabase Storage. Sem isso, as imagens enviadas ficam na pasta /media.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
